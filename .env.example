# Groq API Key (PRIMARY Inference Engine - Fast, Open Weights, Zero Internal Filter Blocks)
# Obtain at: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Google AI Studio Gemini API Key (FALLBACK Backup Provider)
# Obtain your key for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
